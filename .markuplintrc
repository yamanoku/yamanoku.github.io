{
  "extends": [
    "markuplint:html-standard",
    "markuplint:a11y"
  ],
  "nodeRules": [
    {
      "selector": "meta[property]",
      "rules": {
        "no-unknown-attr": {
          "options": {
            "allowAttrs": ["property", "content"]
          }
        },
        "no-disallowed-attr": {
          "options": {
            "allowAttrs": ["property", "content"]
          }
        },
        "require-attr": false
      }
    }
  ]
}
