---
import RecordEntry from "../components/page-index/RecordEntry.astro";
import YearNav from "../components/page-index/YearNav.astro";
import recordsData from "../data/records.json";
import Layout from "../layouts/Layout.astro";
import {
  groupRecordsByYear,
  isUpcoming,
  type RecordItem
} from "../lib/records";

const records = recordsData as RecordItem[];
const recordsByYear = groupRecordsByYear(records);
const years = recordsByYear.map(([year]) => year);
const now = new Date();
---

<Layout>
  <h1 id="content" tabindex="-1">
    <span class="subdomain">records.</span><span class="domain">yamanoku.net</span>
  </h1>
  <p>
    やまのく（yamanoku）のこれまでの登壇・発表のまとめページ
  </p>
  <YearNav years={years} />
  {
    recordsByYear.map(([year, yearRecords], index) => (
      <section
        class:list={[{ "year-section-deferred": index > 0 }]}
        id={`year-${year}`}
      >
        <h2 class="year-heading" id={`year-${year}-heading`}>
          <span class="year-heading-number">{year}</span>年
        </h2>
        {yearRecords.map((record) => (
          <RecordEntry record={record} upcoming={isUpcoming(record.date, now)} />
        ))}
      </section>
    ))
  }
</Layout>

<style>
  h1 {
    display: inline-flex;
    flex-wrap: wrap;

    span {
      word-wrap: anywhere;
    }
  }
  
  section {
    margin: 0;
    margin-block-end: 5lh;
    scroll-margin-top: 100px;
  }

  .year-heading {
    color: var(--y-identity-color);

    @media (prefers-color-scheme: dark) {
      color: var(--y-white-base);
    }
  }

  .year-heading-number {
    font-size: var(--y-h2-size);
  }
</style>
