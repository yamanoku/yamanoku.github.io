---
import RecordEntry from "../components/page-index/RecordEntry.astro";
import YearNav from "../components/page-index/YearNav.astro";
import recordsData from "../data/records.json";
import Layout from "../layouts/Layout.astro";
import {
  groupRecordsByYear,
  isUpcoming,
  type RecordItem
} from "../lib/records";

const records = recordsData as RecordItem[];
const recordsByYear = groupRecordsByYear(records);
const years = recordsByYear.map(([year]) => year);
const now = new Date();
---

<Layout>
  <h1 class="text-y-h2 leading-y-rhythm-4">Records</h1>
  <p>
    やまのく（yamanoku）のこれまでの登壇・発表のまとめページ
  </p>
  <YearNav years={years} />
  {
    recordsByYear.map(([year, yearRecords], index) => (
      <section
        class="scroll-mt-[calc(var(--y-rhythm-5)+var(--y-rhythm-4))]"
        id={`year-${year}`}
        aria-labelledby={`year-${year}-heading`}
      >
        <h2
          class:list={[
            "mb-y-rhythm-2 font-bold leading-y-rhythm-5 text-y-identity-color dark:text-y-white-base",
            index === 0 ? "mt-y-rhythm-3" : "mt-y-rhythm-4"
          ]}
          id={`year-${year}-heading`}
        >
          {year}年
        </h2>
        {yearRecords.map((record) => (
          <RecordEntry record={record} upcoming={isUpcoming(record.date, now)} />
        ))}
      </section>
    ))
  }
</Layout>
