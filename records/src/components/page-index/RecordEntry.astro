---
import { formatTalkDate, type RecordItem } from "../../lib/records";
import ResourceLink from "./ResourceLink.astro";

interface Props {
  record: RecordItem;
  upcoming: boolean;
}

const { record, upcoming } = Astro.props;
---

<article class="record">
  <div class="record-layout">
    <p class="record-when">
      <time datetime={record.date}>{formatTalkDate(record.date)}</time>
      {upcoming && <span>発表予定</span>}
    </p>
    <div>
      <h3 class="record-title">
        {record.event}
      </h3>
      {record.resources.length === 1 ? (
        <p>
          <ResourceLink
            title={record.resources[0].title}
            url={record.resources[0].url}
          />
        </p>
      ) : (
        record.resources.length > 1 && (
          <ul>
            {record.resources.map((resource) => (
              <li>
                <ResourceLink title={resource.title} url={resource.url} />
              </li>
            ))}
          </ul>
        )
      )}
      {record.description && (
        <p class="record-description">{record.description}</p>
      )}
      {record.note && <p>{record.note}</p>}
      {record.eventUrl && (
        <p>
          <ResourceLink title={record.eventUrl} url={record.eventUrl} />
        </p>
      )}
    </div>
  </div>
</article>

<style>
  .record {
    border-block-end-style: dotted;
  }

  .record-layout {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    column-gap: var(--y-rhythm-2);
    row-gap: var(--y-rhythm-2);

    @media (min-width: 40rem) {
      grid-template-columns: 8.75em minmax(0, 1fr);
      row-gap: 0;
    }
  }

  .record-when {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    column-gap: var(--y-rhythm-1);
    margin: 0;
    font-size: var(--y-text-small);

    @media (min-width: 40rem) {
      flex-direction: column;
    }
  }

  .record-title {
    margin-block-start: 0;
    font-weight: 400;
  }

  .record-description {
    font-size: var(--y-text-small);
  }
</style>
