---
import { formatTalkDate, type RecordItem } from "../../lib/records";

interface Props {
  record: RecordItem;
  upcoming: boolean;
}

const { record, upcoming } = Astro.props;
---

<article class="border-b-dotted">
  <div
    class="grid grid-cols-1 items-start gap-x-y-rhythm-2 gap-y-y-rhythm-1 sm:grid-cols-[6.75em_minmax(0,1fr)] sm:gap-y-0"
  >
    <p
      class="m-0 flex flex-row flex-wrap gap-x-y-rhythm-1 text-y-small leading-y-rhythm-3 sm:flex-col"
    >
      <time datetime={record.date}>{formatTalkDate(record.date)}</time>
      {upcoming && <span class="text-y-body-text">予定</span>}
    </p>
    <div>
      <h3 class="mt-0 text-y-h3 leading-y-rhythm-3 font-bold">
        {record.event}
      </h3>
      {record.resources.length === 1 ? (
        <p>
          <a href={record.resources[0].url}>{record.resources[0].title}</a>
        </p>
      ) : (
        record.resources.length > 1 && (
          <ul>
            {record.resources.map((resource) => (
              <li>
                <a href={resource.url}>{resource.title}</a>
              </li>
            ))}
          </ul>
        )
      )}
      {record.description && (
        <p class="text-y-small">{record.description}</p>
      )}
      {record.note && <p class="text-y-small">{record.note}</p>}
    </div>
  </div>
</article>
