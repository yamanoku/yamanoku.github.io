---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

let faviconSrc: string | undefined;
try {
  const { hostname } = new URL(url);
  const domain =
    hostname === "records.yamanoku.net" ||
    hostname.endsWith(".records.yamanoku.net")
      ? "yamanoku.net"
      : hostname;
  faviconSrc = `https://www.google.com/s2/favicons?domain=${domain}&sz=32`;
} catch {
  faviconSrc = undefined;
}
---

<a href={url}>
  {
    faviconSrc && (
      <img
        src={faviconSrc}
        alt=""
        class="me-[0.2em] inline-block size-[1em] max-w-none border-0 align-[-0.125em] [max-inline-size:none]"
        width="14"
        height="14"
        loading="lazy"
        decoding="async"
      />
    )
  }
  {title}
</a>
