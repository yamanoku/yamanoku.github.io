---
import { existsSync } from "node:fs";
import { faviconPublicPath } from "../../lib/favicon-domain";

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

let faviconSrc: string | undefined;
try {
  const publicPath = faviconPublicPath(new URL(url).hostname);
  if (publicPath) {
    const file = new URL(`../../../public${publicPath}`, import.meta.url);
    if (existsSync(file)) faviconSrc = publicPath;
  }
} catch {
  faviconSrc = undefined;
}
---

<a href={url}>
  {
    faviconSrc && (
      <img
        src={faviconSrc}
        alt=""
        width="14"
        height="14"
        loading="lazy"
        class="resource-link-favicon"
      />
    )
  }
  {title}
</a>

<style>
  .resource-link-favicon {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    max-inline-size: none;
    margin-inline-end: 0.2em;
    vertical-align: -0.125em;
    border: 0;
  }
</style>
