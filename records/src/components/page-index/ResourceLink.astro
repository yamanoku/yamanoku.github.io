---
import { existsSync } from "node:fs";
import { faviconPublicPath } from "../../lib/favicon-domain";

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;

let faviconSrc: string | undefined;
try {
  const publicPath = faviconPublicPath(new URL(url).hostname);
  if (publicPath) {
    const file = new URL(`../../../public${publicPath}`, import.meta.url);
    if (existsSync(file)) faviconSrc = publicPath;
  }
} catch {
  faviconSrc = undefined;
}
---

<a href={url}>
  {
    faviconSrc && (
      <img
        src={faviconSrc}
        alt=""
        width="14"
        height="14"
        loading="lazy"
        class="me-[0.2em] inline-block size-[1em] max-w-none border-0 align-[-0.125em] [max-inline-size:none]"
      />
    )
  }
  {title}
</a>
