---
import { copy, type PortfolioLang } from "../../lib/copy";
import {
  orderPortfolio,
  WORK_CATEGORIES,
  type WorkItem
} from "../../lib/portfolio";
import HtmlNightVisual from "./HtmlNightVisual.astro";

interface Props {
  lang: PortfolioLang;
  portfolio: WorkItem[];
}

const { lang, portfolio } = Astro.props;
const text = copy[lang];
const entries = orderPortfolio(portfolio, lang);

type Entry = (typeof entries)[number];

const groups = entries.reduce<Array<{ year: string; items: Entry[] }>>(
  (groups, entry) => {
    const year = entry.work.createdAt.slice(0, 4);
    const current = groups.at(-1);
    if (current?.year === year) {
      current.items.push(entry);
    } else {
      groups.push({ year, items: [entry] });
    }
    return groups;
  },
  []
);
---

<div class="category-catalog">
  <fieldset class="category-filter">
    <legend>{text.categories}</legend>
    {WORK_CATEGORIES.map((category) => (
      <label>
        <input
          id={`category-${category}`}
          type="checkbox"
          name="category"
          value={category}
        />
        <span>{text.category[category]}</span>
      </label>
    ))}
  </fieldset>
  {
    groups.map((group) => (
      <section class="catalog-year">
        <div class="catalog-portfolio">
          {group.items.map(({ work }) => (
            <article
              id={work.id}
              class="work"
              data-categories={work.categories.join(" ")}
            >
              <div class="work-body">
                <h2>
                {work.name}
                {work.github && (
                  <a
                    class="work-github"
                    href={work.github}
                    aria-label={`${work.name} (${text.github})`}
                  >
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 16 16"
                      width="16"
                      height="16"
                    >
                      <path
                        fill="currentColor"
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8"
                      />
                    </svg>
                  </a>
                )}
              </h2>
              <ul class="work-categories" aria-label={text.categories}>
                {work.categories.map((category) => (
                  <li>{text.category[category]}</li>
                ))}
              </ul>
              {work.thumbnail && (
                <img
                  src={work.thumbnail.url}
                  alt=""
                  width={work.thumbnail.width}
                  height={work.thumbnail.height}
                />
              )}
              {work.site && (
                <p class="work-links">
                  {work.site && <a href={work.site}>{work.site}</a>}
                </p>
              )}
              <p>{work.description[lang]}</p>
              {work.articles.length > 0 && (
                <aside>
                  <h3>{text.portfolio_related}</h3>
                  <ul class="work-articles">
                    {work.articles.map((article) => (
                      <li>
                        <a href={article.url}>{article.title}</a>
                      </li>
                    ))}
                  </ul>
                </aside>
              )}
            </div>
          </article>
          ))}
        </div>
      </section>
    ))
  }
</div>
