---
const today = new Date();
---

<footer class="portfolio-foot">
  <p>&copy; Copyright {today.getFullYear()}, Okuto Oyama</p>
  <p>
    Source :
    <a href="https://github.com/yamanoku/yamanoku.github.io/"
      >yamanoku/yamanoku.github.io</a
    >
  </p>
</footer>

<style>
  .portfolio-foot {
    margin-block-start: calc(var(--space-section) + 4.5rem);
    padding-inline: var(--gutter);
    padding-block-end: 1rem;
    font-size: var(--fs-small);

    p + p {
      margin-block-start: 0.25em;
    }

    a:any-link {
      text-decoration-color: currentColor;

      &:hover,
      &:focus-visible {
        text-decoration-color: transparent;
      }
    }
  }
</style>

