---
import { copy, type PortfolioLang } from "../../lib/copy";

interface Props {
  lang: PortfolioLang;
}

const { lang } = Astro.props;
const text = copy[lang];
---

<header>
  <div class="site-brand">
    <svg
      width="48"
      height="48"
      viewBox="0 0 246 242"
      role="img"
      aria-label="yamanoku"
    >
      <path
        class="logo-mark"
        fill-rule="evenodd"
        d="M64,67v54l82,82-46,46v60h56L310,155V96H230l-21,20L160,67H64ZM176,203l-45,46h25L293,113H230l-39,39-31-31H94Z"
      ></path>
    </svg>
    <span>{text.title}</span>
  </div>
  <h1>
    <span class="subdomain">portfolio.</span><span class="domain">yamanoku.net</span>
  </h1>
  <p class="tagline">{text.lead}</p>
  <nav class="site-nav" aria-label={text.multilingual}>
    <ul>
      <li>
        <a
          href="/"
          hreflang="ja"
          lang="ja"
          aria-current={lang === "ja" ? "page" : undefined}>日本語ページ</a
        >
      </li>
      <li>
        <a
          href="/en/"
          hreflang="en"
          lang="en"
          aria-current={lang === "en" ? "page" : undefined}>English Page</a
        >
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    display: flex;
    flex-direction: column;
    padding-inline: var(--gutter);
    padding-block-start: var(--space-hero-top);

    .site-brand {
      display: inline-flex;
      align-items: center;
      gap: var(--y-rhythm-1);
      margin-block: var(--y-rhythm-2);
      margin-inline: 0;
    }

    .logo-mark {
      translate: -64px -67px;
      fill: var(--y-identity-color);

      @media (prefers-color-scheme: dark) {
        fill: var(--y-white-base);
      }

      @media (forced-colors: active) {
        fill: CanvasText;
      }
    }

    h1 {
      font-size: var(--fs-heading-1);
      font-weight: 600;
      display: inline-flex;
      flex-wrap: wrap;

      .domain {
        word-wrap: anywhere;
      }
    }
  }

  .tagline {
    margin-block-start: var(--space-paragraph);
  }

  .site-nav {
    margin-block-start: var(--space-paragraph);

    ul {
      padding: 0;
      list-style: none;
    }

    li {
      display: inline;

      & + li::before {
        content: "｜";
      }
    }

    a:any-link {
      text-decoration-color: transparent;

      &:hover,
      &:focus-visible,
      &[aria-current="page"] {
        text-decoration-color: currentColor;
      }
    }
  }
</style>

