{
  "name": "yamanoku.github.io",
  "author": "yamanoku <0910yama@gmail.com>",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "site": "pnpm --filter @yamanoku/site-cli cli",
    "site:check": "pnpm site -- check",
    "lint": "pnpm run oxlint && pnpm run markuplint",
    "format": "oxfmt .",
    "oxlint": "oxlint --fix .",
    "ox:ci": "oxlint --deny-warnings . && oxfmt --check .",
    "markuplint": "markuplint 'dist/*.html' 'dist/en/**/*.html' 'records/dist/*.html'",
    "yama-normalize": "pnpm -C packages/yama-normalize"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:website",
    "astro": "catalog:website",
    "modern-normalize": "catalog:website",
    "tailwindcss": "catalog:website",
    "vite": "catalog:website"
  },
  "devDependencies": {
    "markuplint": "catalog:website",
    "oxfmt": "catalog:website",
    "oxlint": "catalog:website"
  },
  "workspaces": [
    "packages/*",
    "records",
    "records/presentations"
  ],
  "engines": {
    "pnpm": "12.6.0",
    "npm": "please_use_pnpm_instead"
  },
  "packageManager": "pnpm@12.6.0"
}
