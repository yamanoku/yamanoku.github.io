{
  "name": "yamanoku.github.io",
  "author": "yamanoku <0910yama@gmail.com>",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "site": "pnpm --filter @yamanoku/site-cli cli",
    "site:check": "pnpm site -- check",
    "records": "pnpm --filter records dev:presentation",
    "records:build": "pnpm --filter records build",
    "portfolio:build": "pnpm --filter portfolio build",
    "lint": "pnpm run oxlint && pnpm run markuplint",
    "format": "oxfmt .",
    "oxlint": "oxlint --fix .",
    "ox:ci": "oxlint --deny-warnings . && oxfmt --check .",
    "markuplint": "markuplint 'dist/*.html' 'dist/en/**/*.html' 'records/dist/*.html' 'portfolio/dist/*.html' 'portfolio/dist/en/**/*.html'",
    "yama-normalize": "pnpm -C packages/yama-normalize"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:website",
    "astro": "catalog:website",
    "modern-normalize": "catalog:website",
    "tailwindcss": "catalog:website",
    "vite": "catalog:website"
  },
  "devDependencies": {
    "markuplint": "catalog:website",
    "oxfmt": "catalog:website",
    "oxlint": "catalog:website"
  },
  "workspaces": [
    "packages/*",
    "records",
    "records/presentations",
    "portfolio"
  ],
  "engines": {
    "pnpm": "12.18.0",
    "npm": "please_use_pnpm_instead"
  },
  "packageManager": "pnpm@12.18.0",
  "catalogs": {
    "site-cli": {
      "@types/node": "26.6.6",
      "gunshi": "0.37.3",
      "tsx": "4.23.15",
      "typescript": "7.0.2"
    },
    "website": {
      "@tailwindcss/vite": "4.3.5",
      "astro": "7.4.7",
      "gen-interface-jp": "0.8.0",
      "markuplint": "5.5.0",
      "modern-normalize": "3.0.1",
      "oxfmt": "0.78.0",
      "oxlint": "1.93.0",
      "tailwindcss": "4.3.5",
      "vite": "8.3.7"
    },
    "yama-normalize": {
      "@eslint/css": "2.0.1"
    },
    "presentations": {
      "@11ty/eleventy": "3.1.8",
      "@iconify-json/twemoji": "1.2.5",
      "@iconify-json/vscode-icons": "1.2.97",
      "@slidev/cli": "53.1.0",
      "@slidev/client": "53.1.0",
      "@slidev/theme-apple-basic": "0.25.1",
      "@slidev/theme-default": "0.25.0",
      "@slidev/types": "53.1.0",
      "budoux": "0.10.3",
      "highlight.js": "11.12.0",
      "markdown-it": "14.3.3",
      "markdown-it-footnote": "4.0.0",
      "vue": "3.5.45"
    }
  }
}
