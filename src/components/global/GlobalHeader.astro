---
import { getLanguageFromURL, useTranslations } from "../../i18n/util";

const lang = getLanguageFromURL(Astro.url.pathname);
const t = useTranslations(Astro);
---

<header>
  <div class="site-brand">
    <svg
      width="48"
      height="48"
      viewBox="0 0 246 242"
      role="img"
      aria-label="yamanoku"
    >
      <path
        class="logo-mark"
        fill-rule="evenodd"
        d="M64,67v54l82,82-46,46v60h56L310,155V96H230l-21,20L160,67H64ZM176,203l-45,46h25L293,113H230l-39,39-31-31H94Z"
      ></path>
    </svg>
    <span>{t("header.text-beside-logo")}</span>
  </div>
  <nav class="site-nav" aria-label={t("multilingual")}>
    <ul role="list">
      <li>
        <a href="/" lang="ja" aria-current={lang === "ja" ? "page" : undefined}
          >日本語ページ</a
        >
      </li>
      <li>
        <a
          href="/en/"
          lang="en"
          aria-current={lang === "en" ? "page" : undefined}>English Page</a
        >
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--y-rhythm-1);
    margin-block: var(--y-rhythm-2);
    margin-inline: 0;
  }

  .logo-mark {
    translate: -64px -67px;
    fill: var(--y-identity-color);

    @media (prefers-color-scheme: dark) {
      fill: var(--y-white-base);
    }
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--y-rhythm-2);

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: var(--y-rhythm-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }
</style>
