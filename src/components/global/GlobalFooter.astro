---
import GlobalLinkComponent from "./GlobalLinkComponent.astro";

const today = new Date();
---

<footer>
  <aside id="adring" aria-labelledby="adring-heading">
    <h2 id="adring-heading">Adring</h2>
    <script
      is:inline
      async
      src="https://ar-cdn.net/widget/v1.js"
      data-site-id="6d325526-10ea-4a72-ad15-3a3e6b4f2902"
      data-variant="card"
    ></script>
  </aside>  
  <p>&copy; Copyright {today.getFullYear()}, Okuto Oyama</p>
  <p>
    Source :
    <GlobalLinkComponent
      link={{
        title: "yamanoku/yamanoku.github.io",
        url: "https://github.com/yamanoku/yamanoku.github.io/"
      }}
    />
  </p>
</footer>
