---
import siteContent from "../../../data/site-content.json";
import { getLanguageFromURL, useTranslations } from "../../../i18n/util";

const lang = getLanguageFromURL(Astro.url.pathname) === "en" ? "en" : "ja";
const t = useTranslations(Astro);
const profile = siteContent.profile;
---

<section id="basic" aria-labelledby="basic-heading">
  <h2 id="basic-heading">{t("heading.basic")}</h2>
  <dl>
    <dt>{t("info.real-name")}</dt>
    <dd>
      {
        lang === "en"
          ? profile.realName.en
          : profile.realName.ja.parts.map((part) => (
              <ruby>
                {part.text}
                <rp>(</rp>
                <rt>{part.reading}</rt>
                <rp>)</rp>
              </ruby>
            ))
      }
    </dd>
    <dt>{t("info.hundle-name")}</dt>
    <dd>{profile.handleName[lang]}</dd>
    <dt>{t("info.birthday")}</dt>
    <dd>{profile.birthday[lang]}</dd>
    <dt>{t("info.sex")}</dt>
    <dd>{profile.sex[lang]}</dd>
    <dt>{t("info.birthplace")}</dt>
    <dd>{profile.birthplace[lang]}</dd>
    <dt>{t("info.location")}</dt>
    <dd>{profile.location[lang]}</dd>
    <dt>{t("info.family")}</dt>
    <dd>{profile.family[lang]}</dd>
  </dl>
</section>
