---
import siteContent from "../../../data/site-content.json";
import { getLanguageFromURL, useTranslations } from "../../../i18n/util";
import GlobalListComponent from "../../global/GlobalListComponent.astro";

const lang = getLanguageFromURL(Astro.url.pathname) === "en" ? "en" : "ja";
const t = useTranslations(Astro);
const socialLinks = siteContent.links.social
  .filter((link) => link.visible)
  .map((link) => ({ title: link.title[lang], url: link.url }));
---

<section
  id="social-network-services"
  aria-labelledby="social-network-services_heading"
>
  <h2 id="social-network-services_heading">{t("heading.sns")}</h2>
  <GlobalListComponent list={socialLinks} />
</section>
